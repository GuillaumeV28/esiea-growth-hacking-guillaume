{
  "manifest_version": 3,
  "name": "CyberCap Veille pédagogique",
  "version": "1.0.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "scripting", "tabs"],
  "host_permissions": ["https://www.linkedin.com/*", "https://script.google.com/*", "https://script.googleusercontent.com/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "action": {"default_popup": "popup.html"}
}
